{
  "info": {
    "_postman_id": "23b7b92b-1d2f-4679-b808-66bfad168b9d",
    "name": "Coffe API (HTTP server)",
    "description": "Collection to test the login/session and produtos CRUD of your Node HTTP server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentication flow: login -> me -> logout",
      "item": [
        {
          "name": "Login (POST /api/login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
            },
            "description": "Logs in with email/password. Sets HttpOnly cookie. In Postman, cookies are stored automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204 (no content)', function () {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "",
                  "// Ensure a session cookie was set (Postman cookie jar)",
                  "pm.test('Session cookie present', function () {",
                  "  const cookies = pm.cookies.getAll();",
                  "  const hasSession = cookies.some(c => c.name.toLowerCase() === 'session');",
                  "  pm.expect(hasSession).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me (GET /api/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Has id and email', function () {",
                  "  pm.expect(data).to.have.property('id');",
                  "  pm.expect(data).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout (POST /api/logout)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Produtos",
      "description": "CRUD for produtos. These endpoints are protected in your server after the private gate; ensure you are logged in before using them (if you kept requireAuth).",
      "item": [
        {
          "name": "Create produto (POST /produtos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"nome\": \"Caf\\u00e9 Expresso {{timestamp}}\", \"descricao\": \"Shot de expresso gerado por Postman\", \"valor\": 7.5}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate timestamp to create unique product name",
                  "pm.variables.set('timestamp', Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Returns created id', function () {",
                  "  pm.expect(data).to.have.property('id');",
                  "});",
                  "// store produtoId for later requests",
                  "pm.collectionVariables.set('produtoId', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List produtos (GET /produtos)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is array', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(Array.isArray(data)).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get produto by id (GET /produtos/:id)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/produtos/{{produtoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{produtoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Has id = produtoId', function () {",
                  "  pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('produtoId')));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update produto (PUT /produtos/:id)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{produtoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{produtoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"nome\": \"Caf\\u00e9 Atualizado {{timestamp}}\", \"descricao\": \"Atualizado via Postman\", \"valor\": 9.9}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('timestamp', Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete produto (DELETE /produtos/:id)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/produtos/{{produtoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{produtoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}